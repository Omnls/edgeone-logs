# EdgeOne 实时日志接收器环境变量模板
#
# 复制为 .env（已被 .gitignore 忽略）用于本地记录，或直接在 EdgeOne Pages
# 控制台的环境变量里配置同名项。本文件不得填入真实密钥后提交。

# 必填：接收端独立密钥。控制台「自定义 HTTP 请求头」里配置
# X-Ingest-Key 为同一取值。缺失时接收端返回 503，不会放行。
# 建议至少 24 字符的随机串，例如 openssl rand -base64 32
INGEST_SHARED_KEY=

# 必填：管理查询密钥，请求时通过 X-Admin-Key 请求头传入。
# 必须与 INGEST_SHARED_KEY 不同，两者不可互换。
ADMIN_SHARED_KEY=

# 选填：Pages Blob store 名称，留空则使用 edgeone-realtime-logs。
# 只允许字母、数字、下划线、连字符，UTF-8 最长 64 字节。
BLOB_STORE=

# 选填：控制台「源站鉴权 → 加密签名」的 SecretId / SecretKey。
# 两者必须同时配置或同时留空；只配置一个时接收端返回 503。
# 配置完整后每次投递都强制校验签名，去掉 query 参数不能绕过。
# SecretKey 官方要求固定 32 字符。
EDGEONE_LOG_SECRET_ID=
EDGEONE_LOG_SECRET_KEY=
